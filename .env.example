# Set a strong private value in your shell or Railway Variables. Never commit real credentials.
ADMIN_PASSWORD=replace-with-a-long-random-password
MAX_UPLOAD_MB=25
MAX_CONCURRENT_BUILDS=1
BUILD_RETENTION_HOURS=24
BUILD_TIMEOUT_SECONDS=1200
# Optional; otherwise a session signing key is derived from ADMIN_PASSWORD.
SESSION_SECRET=replace-with-a-different-long-random-secret
